[Unit]
Description=Daily News Pro
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/daily-news-pro/backend
EnvironmentFile=/opt/daily-news-pro/backend/.env
ExecStart=/opt/daily-news-pro/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=5
# 2G 内存服务器保护：限制应用内存上限，避免 Playwright/uvicorn 失控拖垮系统
# 超限会被 systemd 重启（Restart=always），优于整机 OOM
MemoryMax=1700M
MemoryHigh=1400M
# 静态资源/爬虫临时文件写入
ReadWritePaths=/opt/daily-news-pro/backend/data

[Install]
WantedBy=multi-user.target
